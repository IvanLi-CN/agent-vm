{
  "name": "@agent-vm/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun content/generate.ts && react-router dev --host 127.0.0.1",
    "build": "bun content/generate.ts && react-router build",
    "preview": "bun content/serve.ts",
    "check": "bun content/generate.ts --strict && react-router typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -c .storybook --port $DOCS_PORT",
    "build:storybook": "storybook build -c .storybook -o storybook-static"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "16.19.3",
    "github-slugger": "^2.0.0",
    "isbot": "^5",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile-message": "4.0.4"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@types/mdast": "^4.0.4"
  }
}
