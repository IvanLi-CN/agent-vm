[Unit]
Description=Agent VM native Go control service (%i slot)
Requires=agent-vm-rqlite.service
After=agent-vm-rqlite.service incus.service
Wants=incus.service
ConditionPathExists=/var/lib/agent-vm-native/slots/%i/bin/agent-vm-server
ConditionPathExists=/etc/agent-vm-native/slots/%i/config.json

[Service]
Type=simple
# The deploy adapter lives in bin/ on a fresh install and in maintenance/
# after host account migration; older releases resolved it differently.
# The shared `/usr/bin/sh -c` wrapper picks whichever exists so one unit
# definition serves both forms.
ExecStartPre=/usr/bin/sh -c 'adapter=$(command -v /opt/agent-vm-native/maintenance/agent-vm-deploy || echo /opt/agent-vm-native/bin/agent-vm-deploy); exec "$adapter" wait-authority --slot %i --timeout 55'
ExecStart=/var/lib/agent-vm-native/slots/%i/bin/agent-vm-server serve --config /etc/agent-vm-native/slots/%i/config.json --manifest /var/lib/agent-vm-native/slots/%i/release-manifest.json
ExecStartPost=/usr/bin/sh -c 'adapter=$(command -v /opt/agent-vm-native/maintenance/agent-vm-deploy || echo /opt/agent-vm-native/bin/agent-vm-deploy); exec "$adapter" wait-process --slot %i --timeout 55'
Environment=HOME=/var/lib/agent-vm-native
Environment=SSL_CERT_FILE=/etc/agent-vm-native/tls/rqlite/server.crt
CPUWeight=100
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/agent-vm-native /run/agent-vm-native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Group=agent-vm-web
UMask=0077
RuntimeDirectory=agent-vm-native/%i
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
