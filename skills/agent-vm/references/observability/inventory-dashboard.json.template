    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 6,
      "panels": [],
      "title": "Managed VM inventory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "description": "One bounded row per managed task. RAM and disk columns are GiB; lease expiry is Unix seconds. Active and transitional/failed rows are visible by default; cached and absent history remains available in the state filter and is collapsed by default.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state_order"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "state_order",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(agent_vm_task_info{job=\"$controller_job\",state=~\"$state\"}, \"state_order\", \"1\", \"state\", \"^active$\"), \"state_order\", \"2\", \"state\", \"^preparing$\"), \"state_order\", \"3\", \"state\", \"^failed$\"), \"state_order\", \"4\", \"state\", \"^closing$\"), \"state_order\", \"4\", \"state\", \"^deleting$\"), \"state_order\", \"5\", \"state\", \"^cached$\"), \"state_order\", \"6\", \"state\", \"^absent$\"), \"task_key\", \"|\", \"task_id\", \"state\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(sum by (task_id, state) (agent_vm_task_cpu_vcpu{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} CPU",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(sum by (task_id, state) (agent_vm_task_memory_bytes{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\") / 1073741824",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} RAM",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(sum by (task_id, state) (agent_vm_task_disk_bytes{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\") / 1073741824",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} disk",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(max by (task_id, state) (agent_vm_task_lease_expires_at_seconds{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} lease",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(max by (task_id, state, vm_ip, ssh_host_port) (agent_vm_task_ssh_mapping{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} SSH",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_UID__"
          },
          "editorMode": "code",
          "expr": "label_join(max by (task_id, state, code, phase) (agent_vm_task_last_error_info{job=\"$controller_job\",state=~\"$state\"}), \"task_key\", \"|\", \"task_id\", \"state\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{task_id}} error",
          "refId": "G"
        }
      ],
      "title": "Managed VM inventory",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "task_key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "job": true,
              "service": true,
              "task_key": true,
              "task_key 1": true,
              "task_key 2": true,
              "task_key 3": true,
              "task_key 4": true,
              "task_key 5": true,
              "task_key 6": true,
              "task_key 7": true,
              "task_id 1": true,
              "task_id 2": true,
              "task_id 3": true,
              "task_id 4": true,
              "task_id 5": true,
              "task_id 6": true,
              "task_id 7": true,
              "state_order": true,
              "state 2": true,
              "state 3": true,
              "state 4": true,
              "state 5": true,
              "state 6": true,
              "state 7": true,
              "Value #A": true,
              "Value #F": true,
              "Value #G": true
            },
            "renameByName": {
              "task_id": "Task ID",
              "state 1": "state",
              "Value #B": "CPU vCPU",
              "Value #C": "RAM GiB",
              "Value #D": "Disk GiB",
              "Value #E": "Lease expiry (Unix s)",
              "vm_ip": "VM IP",
              "ssh_host_port": "SSH port",
              "code": "Error code",
              "phase": "Error phase"
            }
          }
        }
      ],
      "type": "table"
    },
