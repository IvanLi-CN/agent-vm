{
	admin off
	auto_https off
	storage file_system /var/lib/agent-vm-native/caddy
	log default {
		output stderr
		format filter {
			request>uri regexp "\\?.*" "?REDACTED"
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Csrf-Token delete
			resp_headers>Set-Cookie delete
			wrap json
		}
	}
}

https://{$AGENT_VM_DOMAIN} {
	tls force_automate {
		dns dnspod {env.DNSPOD_TOKEN}
	}
	log default

	@internal path /internal/v1/*
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy unix//var/lib/agent-vm-native/active/app.sock {
			header_up -X-Forwarded-User
			header_up -X-Original-URL
			header_up -X-Original-Method
			header_up -Forwarded
		}
	}
}
