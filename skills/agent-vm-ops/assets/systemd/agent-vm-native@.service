[Unit]
Description=Agent VM native Go control service (%i slot)
Requires=agent-vm-rqlite.service
After=agent-vm-rqlite.service incus.service
Wants=incus.service
ConditionPathExists=/var/lib/agent-vm-native/slots/%i/bin/agent-vm-control
ConditionPathExists=/etc/agent-vm-native/slots/%i/config.json

[Service]
Type=simple
ExecStart=/var/lib/agent-vm-native/slots/%i/bin/agent-vm-control serve --config /etc/agent-vm-native/slots/%i/config.json --manifest /var/lib/agent-vm-native/slots/%i/release-manifest.json
Environment=HOME=/var/lib/agent-vm-native
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/agent-vm-native /run/agent-vm-native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Group=agent-vm-web
UMask=0077
RuntimeDirectory=agent-vm-native/%i
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
