[Unit]
Description=Agent VM native Go control service (%i slot)
Requires=agent-vm-rqlite.service
After=agent-vm-rqlite.service incus.service
Wants=incus.service
ConditionPathExists=/opt/agent-vm-native/slots/%i/bin/agent-vm-control
ConditionPathExists=/opt/agent-vm-native/slots/%i/release-manifest.json
ConditionPathExists=/etc/agent-vm-native/slots/%i/config.json

[Service]
Type=simple
ExecStart=/opt/agent-vm-native/slots/%i/bin/agent-vm-control serve --config /etc/agent-vm-native/slots/%i/config.json --slot %i --socket /run/agent-vm-native/%i/app.sock --manifest /opt/agent-vm-native/slots/%i/release-manifest.json
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/agent-vm-native /run/agent-vm-native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Group=agent-vm-web
UMask=0077
RuntimeDirectory=agent-vm-native/%i
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
