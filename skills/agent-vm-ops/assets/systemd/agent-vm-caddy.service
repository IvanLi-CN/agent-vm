[Unit]
Description=Agent VM Caddy edge proxy
After=network-online.target agent-vm-rqlite.service agent-vm-native@blue.service agent-vm-native@green.service
Wants=network-online.target agent-vm-rqlite.service
ConditionPathExists=/etc/agent-vm-native/Caddyfile
ConditionPathExists=/etc/agent-vm-native/caddy.env
RequiresMountsFor=/var/lib/agent-vm-native/active/app.sock

[Service]
Type=simple
User=caddy
Group=caddy
SupplementaryGroups=agent-vm-web
EnvironmentFile=/etc/agent-vm-native/caddy.env
ExecStartPre=/usr/bin/test -L /var/lib/agent-vm-native/active
ExecStartPre=/usr/bin/test -S /var/lib/agent-vm-native/active/app.sock
ExecStartPre=/bin/sh -c 'test "$(stat -c "%%u:%%g:%%a" /etc/agent-vm-native/caddy.env)" = "0:0:600"'
ExecStart=/usr/local/bin/caddy run --config /etc/agent-vm-native/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/agent-vm-native/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-vm-native/caddy
ReadOnlyPaths=/etc/agent-vm-native/Caddyfile /etc/agent-vm-native/caddy.env
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
