{
  "project": "<incus-project>",
  "profile": "<incus-profile>",
  "image_alias": "<image-alias>",
  "image_fingerprint": "<64-lowercase-hex-fingerprint>",
  "network": "<incus-network>",
  "network_acl": "<network-acl-name>",
  "pool": "<incus-storage-pool>",
  "host_address": "<control-host-ip>",
  "port_start": 20000,
  "port_end": 29999,
  "vm_ip_start": "<vm-ip-start>",
  "vm_ip_end": "<vm-ip-end>",
  "gateway_ip": "<gateway-ip>",
  "initial_lease_seconds": 1800,
  "renew_seconds": 900,
  "max_lease_seconds": 7200,
  "cache_seconds": 86400,
  "create_cost_bytes": 4294967296,
  "resume_cost_bytes": 1073741824,
  "resize_cost_bytes": 1073741824,
  "storage_path": "<incus-pool-filesystem-path>",
  "required_guest_tools": [
    "python3",
    "sshd",
    "rsync",
    "docker",
    "growpart"
  ],
  "state_db": "/var/lib/agent-vm-native/state.sqlite3",
  "timer_dir": "/etc/systemd/system",
  "release_fence_path": "/run/agent-vm-native/release-activation.fence",
  "cpu_budget": 15,
  "memory_budget_mib": 12288,
  "cpu_overcommit_ratio": 4,
  "memory_overcommit_ratio": 4,
  "disk_low_bytes": 10737418240,
  "disk_target_bytes": 21474836480
}
