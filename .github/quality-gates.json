{
  "schema_version": 1,
  "policy": {
    "baseline_policy": "explicit-waiver-required",
    "require_signed_commits": true,
    "branch_protection": {
      "protected_branches": ["main"],
      "require_pull_request": true,
      "disallow_direct_pushes": true
    }
  },
  "required_checks": ["PR gate (ubuntu-latest)", "PR gate (macos-latest)"],
  "informational_checks": ["Main gate (ubuntu-latest)", "Main gate (macos-latest)"],
  "waivers": [],
  "expected_pr_workflows": [
    {
      "workflow": "CI (PR)",
      "jobs": ["PR gate (ubuntu-latest)", "PR gate (macos-latest)"]
    }
  ],
  "release_checks": ["Main gate (ubuntu-latest)", "Main gate (macos-latest)"],
  "queue_policy": {
    "queue": "max",
    "required_pull_request_events": ["opened", "synchronize", "reopened", "ready_for_review"],
    "max_concurrency": 1,
    "cancel_in_progress": false,
    "namespace": "pr"
  },
  "platform_alignment": {
    "status": "audit-required",
    "checked_in_contract_is_not_platform_enablement": true
  }
}
