{
  "schema_version": 1,
  "product": {
    "name": "agent-vm",
    "versioning": "semver-2.0.0",
    "first_public_version": "1.0.0",
    "components": ["client", "control-service", "compatibility-bridge", "systemd-assets"],
    "shared_product_version": true,
    "protocol_version": 4,
    "manifest_format": 4,
    "legacy_read_formats": [1, 2, 3],
    "legacy_write_formats": [],
    "source_identity": "source_revision",
    "protocol_compatibility_identity": "source_revision"
  },
  "release_entrypoint": {
    "mode": "manual",
    "workflow": "Release",
    "input": "target",
    "allowed_symbolic_targets": ["patch", "minor", "major"],
    "explicit_targets_allow_prerelease": true,
    "requires_trusted_final_baseline": true,
    "first_release_requires": "1.0.0",
    "source": "validated-main-head",
    "automatic_pr_on_merge": false
  },
  "identity_and_recovery": {
    "claim_before_freeze": true,
    "state": "append-only",
    "recovery_operations": ["recover", "abandon"],
    "recovery_reuses_identity": true,
    "recovery_may_reselect_version": false,
    "recovery_may_reselect_source": false,
    "artifact_overwrite": false,
    "publish_completion": "github-release-and-versioned-assets-verified"
  },
  "toolchain": {
    "bun": "1.4.4",
    "go": "go1.27.3",
    "cgo_enabled": false,
    "targets": ["linux/amd64", "linux/arm64"]
  },
  "deployment_artifacts": {
    "metadata": "skills/agent-vm-ops/assets/blue-green/deployment-components.json",
    "automatic_install": false,
    "components": [
      {
        "name": "caddy",
        "version_major": 2,
        "repository": "caddyserver/caddy",
        "version_policy": "operator-selected-v2-release",
        "builder": "xcaddy",
        "provider_module": "github.com/caddy-dns/dnspod",
        "provider_ref": "fb7cc31cc04c68a304b8d2672c3e5d9f2ad3d7ba",
        "provider_module_name": "dns.providers.dnspod",
        "checksum_algorithm": "sha512",
        "artifact_verification": "operator-recorded-custom-build"
      },
      {
        "name": "rqlite",
        "version": "10.5.2",
        "repository": "rqlite/rqlite",
        "checksum_algorithm": "sha256",
        "artifacts": {
          "linux/amd64": {
            "url": "https://github.com/rqlite/rqlite/releases/download/v10.5.2/rqlite-v10.5.2-linux-amd64.tar.gz",
            "checksum": "1a04a7c2c542e8e1c1347bd31af0fa9ef7043febb3c4d1806d36bc1702c6fa0f"
          },
          "linux/arm64": {
            "url": "https://github.com/rqlite/rqlite/releases/download/v10.5.2/rqlite-v10.5.2-linux-arm64.tar.gz",
            "checksum": "44b4bd7ca39720dee3b916f9ef59da117c07ddc008704ac25e56385e56951b8a"
          }
        }
      }
    ]
  },
  "deployment_boundary": {
    "automatic_deploy": false,
    "native_install_validation": "conditional-on-incus-systemd-deployment-boundary",
    "this_change_runs_native_install": false
  },
  "platform_preconditions": {
    "protected_main_required": true,
    "required_main_check": "Main gate",
    "status": "enabled"
  }
}
