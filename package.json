{
  "name": "agent-vm",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc --noEmit -p web/tsconfig.json",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:demo": "vite --config web/vite.config.ts --mode demo",
    "build:web": "VITE_MANAGEMENT_API=real vite build --config web/vite.config.ts",
    "build:demo": "vite build --config web/vite.config.ts --mode demo",
    "preview:web": "vite preview --config web/vite.config.ts",
    "preview:demo": "vite preview --config web/vite.config.ts --mode demo",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "test:storybook:a11y": "playwright test --config web/storybook.playwright.config.ts",
    "storybook": "storybook dev -p 6006 -c web/.storybook",
    "build-storybook": "storybook build -c web/.storybook -o web/storybook-static",
    "react-doctor:web": "react-doctor --project web --no-supply-chain --no-score --no-telemetry --blocking error",
    "react-doctor:web:staged": "react-doctor --staged --project web --no-supply-chain --no-score --no-telemetry --blocking error",
    "react-doctor:web:ci": "react-doctor --scope changed --base origin/main --project web --no-supply-chain --no-score --no-telemetry --blocking error",
    "check": "bun run typecheck && python3 bin/test_agent_vm_documentation.py && go -C skills/agent-vm-ops/control vet ./...",
    "test:policy-audit": "python3 .agents/skills/quality-gates/assets/scripts/check_quality_gates.py --repo-root . --declaration .github/quality-gates.json --allow-unchecked-branch-protection",
    "test:platform-audit": "bun test skills/agent-vm-ops/tests/platform-audit.test.ts",
    "test:repo": "bun run bin/test_runner.ts --scope repo",
    "test:skills": "bun run bin/test_runner.ts --scope skills"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "axe-core": "4.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.3",
    "jsdom": "^30.1.3",
    "react-doctor": "0.9.18",
    "storybook": "^8.6.14",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9"
  }
}
